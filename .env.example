# Copy this file to .env and fill in your own values.
# Never commit the real .env — it is already listed in .gitignore.

# Web server
PORT=5000
SESSION_SECRET=replace-with-a-long-random-string

# MySQL connection (created during setup — see README.md)
# NODE_ENV=production on a host; DB_SSL=true for managed MySQL (Aiven/Railway)
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=freshmarket
DB_PASSWORD=your-password-here
DB_NAME=freshmarket
DB_SSL=false
